---
import { FLAVOR_AXES, type Flavor } from '../lib/data';
interface Props { flavor?: Partial<Flavor>; color: string; }
const { flavor = {}, color } = Astro.props;
const R = 110, C = 150, max = 5;
const n = FLAVOR_AXES.length;
const pt = (i: number, r: number) => {
  const a = (Math.PI * 2 * i) / n - Math.PI / 2;
  return [C + Math.cos(a) * r, C + Math.sin(a) * r];
};
const ring = (k: number) => FLAVOR_AXES.map((_, i) => pt(i, (R * k) / max).join(',')).join(' ');
const shape = FLAVOR_AXES.map((ax, i) => pt(i, (R * (flavor[ax] ?? 0)) / max).join(',')).join(' ');
const summary = FLAVOR_AXES.map((ax) => `${ax} ${flavor[ax] ?? 0} of 5`).join(', ');
---
<svg class="radar" viewBox="0 0 300 300" role="img" aria-label={`Flavor profile: ${summary}`}>
  {[1, 2, 3, 4, 5].map((k) => <polygon points={ring(k)} class="ring" />)}
  {FLAVOR_AXES.map((_, i) => { const [x, y] = pt(i, R); return <line x1={C} y1={C} x2={x} y2={y} class="spoke" />; })}
  <polygon points={shape} fill={color} fill-opacity="0.55" stroke={color} stroke-width="2" stroke-linejoin="round" />
  {FLAVOR_AXES.map((ax, i) => {
    const [x, y] = pt(i, R + 22);
    return <text x={x} y={y} text-anchor="middle" dominant-baseline="middle">{ax}</text>;
  })}
</svg>
<style>
  .radar { width: 100%; max-width: 340px; height: auto; overflow: visible; }
  .ring { fill: none; stroke: var(--stave); stroke-width: 1; }
  .spoke { stroke: var(--stave); stroke-width: 1; }
  text { fill: var(--muted); font-family: var(--display); font-weight: 600; font-size: 15px; }
</style>

---
// One Glencairn-style glass. Filled with the whiskey's color when tasted, empty outline otherwise.
interface Props { fill?: string; size?: number; label?: string; delay?: number; }
const { fill, size = 22, label, delay = 0 } = Astro.props;
const id = `bowl-${Math.random().toString(36).slice(2, 9)}`;
const bowl = 'M5 1h10c0 5 3 8.5 3 14s-3 7.5-6 8v4l4 2v2H4v-2l4-2v-4c-3-.5-6-2.5-6-8S5 6 5 1Z';
---
<svg class:list={['glass', { filled: !!fill }]} viewBox="0 0 20 32" width={size} height={size * 1.6}
  role={label ? 'img' : 'presentation'} aria-label={label} style={`--d:${delay}ms`}>
  {fill && (
    <clipPath id={id}><path d="M5 1h10c0 5 3 8.5 3 14s-3 7.5-6 8H8c-3-.5-6-2.5-6-8S5 6 5 1Z" /></clipPath>
    <g clip-path={`url(#${id})`}>
      <rect class="liquid" x="0" y="13" width="20" height="11" fill={fill} />
    </g>
  )}
  <path d={bowl} fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
</svg>
<style>
  .glass { color: var(--stave); overflow: visible; }
  .glass.filled { color: #cbb89f; }
  .liquid { transform-box: fill-box; transform-origin: bottom; animation: pour 700ms cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d); }
  @keyframes pour { from { transform: scaleY(0); } to { transform: scaleY(1); } }
</style>

---
// The Buy / Bar Pour / Pass stamp.
interface Props { verdict: 'Buy' | 'Bar Pour' | 'Pass'; size?: 'sm' | 'lg'; }
const { verdict, size = 'sm' } = Astro.props;
const key = verdict === 'Buy' ? 'buy' : verdict === 'Pass' ? 'pass' : 'pour';
---
<span class:list={['stamp', key, size]}>{verdict}</span>
<style>
  .stamp {
    display: inline-block; font-family: var(--stencil); font-weight: 800; line-height: 1;
    border: 2px solid currentColor; padding: 4px 8px 3px; border-radius: 2px; white-space: nowrap;
  }
  .sm { font-size: 1rem; }
  .lg { font-size: 2.2rem; padding: 8px 14px 6px; border-width: 3px; transform: rotate(-4deg); }
  .buy { color: #8fc28a; }
  .pour { color: var(--brass); }
  .pass { color: var(--pass); }
</style>
